# TradeSys Dashboard — configuration
#
# Copy to .env and fill in. Every value below is optional.
# the app degrades feature by feature rather than refusing to start.
#
#   cp .env.example .env

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Address the server listens on.
HTTP_ADDR=:8080
# Shared password for both operators (HTTP basic auth; any username works).
# Leave empty ONLY for local development — an empty value disables auth.

# ─── Storage ─────────────────────────────────────────────────────────────────
# SQLite file. The directory is created if missing.
DB_PATH=./data/tradesys.db

# ─── Market data ─────────────────────────────────────────────────────────────
# Provider priority, highest first. Valid: yahoo, twelvedata, alphavantage,
# synthetic.
#
# Yahoo needs no key and has no request limit, so it leads by default and the
# budgeted providers are kept in reserve. IMPORTANT: Yahoo blocks datacenter
# IP ranges. If you are running on a rented server (Hetzner, DigitalOcean, AWS
# and friends) it will fail every request, so drop it and lead with
# twelvedata:
#
#   MARKETDATA_ORDER=twelvedata,alphavantage
MARKETDATA_ORDER=yfinance,twelvedata,alphavantage

# The yfinance sidecar (services/yfinance), started by docker compose. It is
# the depth provider: five or more years of daily history across NSE, BSE and
# US markets, with no daily request budget.
YFINANCE_URL=http://yfinance:8787

# false: prices as they actually traded, split-adjusted only. This is what a
#        broker screen shows and what a chart should display.
# true:  additionally adjusted for dividends, i.e. total return. Useful for
#        comparing performance, misleading as a price.
YFINANCE_ADJUST=false

# Free key: https://www.alphavantage.co/support/#api-key
# Without this, Alpha Vantage is skipped entirely (reported as "unconfigured",
# not as a fault).
ALPHAVANTAGE_API_KEY=

# Hard daily request cap, enforced before any network call and persisted across
# restarts. The free tier is ~25/day; do not raise this above your plan.
ALPHAVANTAGE_DAILY_LIMIT=25

# Free key: https://twelvedata.com/pricing
# Covers NSE and BSE as well as US markets, and — unlike Yahoo — answers
# normally from datacenter IPs. The free tier is ~800 requests/day.
TWELVEDATA_API_KEY=

# Hard daily request cap, enforced before any network call and persisted across
# restarts. Do not raise this above your plan.
TWELVEDATA_DAILY_LIMIT=800

# Serve generated, non-market data when every real provider fails. Useful for
# evaluating the app without keys. Anything it produces is labelled
# "synthetic" in the UI. Never leave this on for real analysis.
ENABLE_SYNTHETIC_FALLBACK=false

# ─── Notifications (Telegram) ────────────────────────────────────────────────
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: override Telegram's API host, for deployments behind an egress
# proxy. Leave empty to use https://api.telegram.org.
TELEGRAM_API_BASE_URL=

# ─── AI layer (OpenAI-compatible chat completions) ───────────────────────────
# Any OpenAI-compatible endpoint. Function calling and JSON-schema enforcement
# are NOT assumed; structured output is prompted and parsed defensively.
LLM_BASE_URL=
LLM_MODEL=
# Optional cheaper model for high-volume work (news scoring). Defaults to LLM_MODEL.
LLM_CHEAP_MODEL=
LLM_API_KEY=

# Optional. A JSON object merged into every chat-completions request, for
# vendor parameters outside the OpenAI schema.
#
# Xiaomi MiMo is a reasoning model: it emits a chain of thought before the
# answer, which is slower and spends tokens. To turn that off:
#
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
#
# Leave it empty to keep reasoning on — answers are better, calls take longer.
LLM_EXTRA_BODY=
# Hard monthly token cap, enforced before each call and recorded after. Past
# this, AI features report "budget reached" and everything else — prices,
# algorithms, alerts — continues unaffected. Set to 0 to disable AI entirely.
LLM_MONTHLY_TOKEN_BUDGET=4000000000

# ─── Search ──────────────────────────────────────────────────────────────────
# Preferred provider: tavily or brave. The other is used as a fallback when
# the preferred one errors.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# ─── Presentation ────────────────────────────────────────────────────────────
# All timestamps are stored in UTC and displayed in this zone.
DISPLAY_TZ=Asia/Kolkata

# ─── Diagnostics ─────────────────────────────────────────────────────────────
# debug, info, warn, or error.
LOG_LEVEL=info

# PostgreSQL. The database publishes no host port, so it is reachable only
# from inside the compose network. Set a real password anyway.
POSTGRES_USER=tradesys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradesys

# Overridden by docker-compose; set only when running the binary directly.
# DATABASE_URL=postgres://tradesys:change-me@localhost:5432/tradesys?sslmode=disable

# Backups. A compressed dump is written every six hours to the
# tradesys-backups volume; this is how many days of them to keep.
BACKUP_KEEP_DAYS=14

# The port Postgres is published on, bound to loopback only. Used by
# integration tests and psql; the application reaches it over the compose
# network and does not need it.
POSTGRES_HOST_PORT=5433

# Access is by API key. Keys are issued on the server only — there is no
# endpoint for it, so the ability to grant access is tied to shell access:
#   tradesys -issue-key -name "Your name" -role owner
#   tradesys -list-keys
#   tradesys -revoke-key tsk_xxxxxxxx
#
# Roles: owner (may manage keys), operator (full use), viewer (read only).
# A deployment with no keys issued is OPEN, so that a fresh install can be
# reached long enough to issue the first one.
#
# Signs browser session cookies so they survive a restart. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=
