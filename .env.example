# Bellwether — configuration
#
#   cp .env.example .env
#
# Everything is optional. With nothing filled in, the app still starts, ingests
# the keyless official sources, serves Yahoo/yfinance prices, and reports each
# AI feature as unavailable rather than failing to boot. Each key you add
# switches on the features that need it; nothing else changes.
#
# Never commit .env. It is gitignored, along with every .env.* except this file.

# ─── Access ──────────────────────────────────────────────────────────────────
# Access is by API key, issued from the server shell (there is no endpoint for
# it, so the power to grant access stays with whoever holds the shell):
#
#   docker compose exec tradesys tradesys -issue-key -name "alice" -role owner
#
# Roles: owner (manages keys), operator (full use), viewer (read only).
# A deployment with no keys is locked until an owner key is issued.

# Signs session cookies so sign-ins survive a restart.
#   openssl rand -base64 48
SESSION_SECRET=

# Local development only: skip sign-in entirely.
ALLOW_UNAUTHENTICATED=false

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose runs Postgres for you and builds DATABASE_URL from these, so
# DATABASE_URL below only matters when you run the binary directly.
POSTGRES_USER=tradesys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradesys
# DATABASE_URL=postgres://tradesys:change-me@localhost:5433/tradesys?sslmode=disable

# Loopback port for psql and the integration tests. The app does not use it.
POSTGRES_HOST_PORT=5433

# Optional second Postgres for aged news (Neon, Supabase, any Postgres 15+).
# News older than NEWS_HOT_WINDOW moves there; reads span both transparently.
# sslmode=require and pooler-safe settings are applied automatically.
NEWS_ARCHIVE_DATABASE_URL=
NEWS_HOT_WINDOW=720h

# Scheduled pg_dump every 6h into the tradesys-backups volume.
BACKUP_KEEP_DAYS=14

# ─── Market data ─────────────────────────────────────────────────────────────
# Provider priority, highest first: yfinance, yahoo, twelvedata, alphavantage.
# The yfinance sidecar ships with compose and has no request budget.
#
# Yahoo's public endpoint returns 429 to datacenter IP ranges (Hetzner, AWS,
# DigitalOcean…) on every request; the sidecar is unaffected.
MARKETDATA_ORDER=yfinance,twelvedata,alphavantage
YFINANCE_URL=http://yfinance:8787
# false: prices as traded (split-adjusted). true: total return, dividends in.
YFINANCE_ADJUST=false

# Free keys, used as budgeted fallbacks. The daily caps are enforced before any
# network call and persist across restarts — do not set them above your plan.
TWELVEDATA_API_KEY=
TWELVEDATA_DAILY_LIMIT=800
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_LIMIT=25

# Generated, clearly-labelled fake prices when every provider fails. For demos
# without keys. Never for real analysis.
ENABLE_SYNTHETIC_FALLBACK=false

# ─── SEC EDGAR ───────────────────────────────────────────────────────────────
# SEC refuses requests whose User-Agent does not name a real contact. Left
# empty, the SEC sources (8-K, Form 4, 13F) are simply not registered.
#   SEC_USER_AGENT=Bellwether/1.0 (you@example.com)
SEC_USER_AGENT=

# ─── Decisions: Jev (TypeSafe AI) ────────────────────────────────────────────
# Jev makes the small, high-volume decisions: event type, importance, whether
# an item is an event at all, direction per company, article relevance.
# Each answer is gated by Jev's own confidence. Empty key: those decisions
# fall back to the text model below.  https://typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# USD per million input tokens, used only to report spend.
JEV_INPUT_PRICE_USD=0.042

# ─── Prose: any OpenAI-compatible chat model ─────────────────────────────────
# Writes the morning brief, event briefs and research answers. No function
# calling or JSON mode is assumed. Examples:
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com
#   Ollama     LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=
# Optional cheaper model for high-volume work. Defaults to LLM_MODEL.
LLM_CHEAP_MODEL=
LLM_API_KEY=
# Optional JSON merged into every request, for vendor-specific parameters,
# e.g. {"thinking":{"type":"disabled"}}.
LLM_EXTRA_BODY=

# Two independent spend guards. Both are checked before the call, against the
# worst case, so concurrent calls cannot overshoot together.
#   Daily USD ceiling (priced models), resets 00:00 UTC.
LLM_DAILY_USD_CAP=1.00
#   Monthly token ceiling. 0 disables the text model entirely.
LLM_MONTHLY_TOKEN_BUDGET=2000000

# ─── Research search ─────────────────────────────────────────────────────────
# Compose also runs a private SearXNG node, which needs no key. These add
# commercial providers; the preferred one is tried first.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# ─── Alerts (Telegram) ───────────────────────────────────────────────────────
# Create a bot with @BotFather; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for deployments behind an egress proxy.
TELEGRAM_API_BASE_URL=

# ─── Presentation & diagnostics ──────────────────────────────────────────────
# Times are stored in UTC and shown in this zone. Market jobs always run on
# exchange time regardless.
DISPLAY_TZ=America/New_York
# debug, info, warn, error
LOG_LEVEL=info

# ─── Publishing (optional) ───────────────────────────────────────────────────
# By default the app listens on http://127.0.0.1:8080 only. To serve it on a
# domain with automatic HTTPS (Caddy + Let's Encrypt, see deploy/Caddyfile):
#   PUBLIC_HOSTNAME=bellwether.example.com
#   COMPOSE_PROFILES=public
PUBLIC_HOSTNAME=
COMPOSE_PROFILES=
